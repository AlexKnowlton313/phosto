{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "aws-lambda"]
  },
  "include": ["api/**/*.ts", "derive/**/*.ts", "shared/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "layers"]
}
